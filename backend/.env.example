# =============================================================================
# Wearable Cardiac Risk Monitoring API — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
# =============================================================================

# ---- Application -----------------------------------------------------------
APP_NAME="Wearable Cardiac Risk Monitoring API"
APP_VERSION=1.0.0
DEBUG=false

# ---- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins.  Use * during development.
CORS_ORIGINS=*

# ---- PostgreSQL ------------------------------------------------------------
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:admin123@localhost:5432/cardiac_risk_db

# ---- ML Model Paths (overrides – defaults point inside app/ml/) -------------
# ML_MODEL_PATH=
# ML_SCALER_PATH=
# ML_ENCODER_PATH=
# ML_FEATURE_COLUMNS_PATH=

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=logs/app.log
